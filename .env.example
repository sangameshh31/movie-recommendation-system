# ---- CineMatch AI configuration (copy to .env) ----

# Dataset: 100k | 1m | 25m  (25m is a large download, use with caution)
MOVIELENS_SIZE=100k

# Qdrant: leave empty for embedded local storage (no server needed).
# Set to an http URL to use a Docker/cloud Qdrant instance, e.g. http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=

# Embedding model on HuggingFace Hub
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM explanations via Ollama (local). Leave base URL empty to use rule-based
# explanations only. Model name follows the `ollama pull <model>` convention.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: TMDB enrichment for real plot overviews (used by content pipeline)
TMDB_API_KEY=
